{
  "aadhaar": {
    "keywords": [
      "unique identification authority",
      "government of india",
      "mera aadhaar",
      "meri pehchan",
      "uidai",
      "enrollment no",
      "help@uidai.gov.in"
    ],
    "regex": [
      "\\b\\d{4}\\s+\\d{4}\\s+\\d{4}\\b",
      "\\b[xX]{4}\\s+[xX]{4}\\s+\\d{4}\\b"
    ],
    "min_score": 25
  },
