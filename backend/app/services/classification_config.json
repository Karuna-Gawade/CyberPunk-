{
  "aadhaar": {
    "keywords": [
      "unique identification authority",
      "government of india",
      "mera aadhaar",
      "meri pehchan",
      "uidai",
      "enrollment no",
      "help@uidai.gov.in"
    ],
    "regex": [
      "\\b\\d{4}\\s+\\d{4}\\s+\\d{4}\\b",
      "\\b[xX]{4}\\s+[xX]{4}\\s+\\d{4}\\b"
    ],
    "min_score": 25
  },
  "pan": {
    "keywords": [
      "income tax department",
      "govt. of india",
      "permanent account number",
      "father's name",
      "date of birth"
    ],
    "regex": [
      "\\b[A-Z]{5}[0-9]{4}[A-Z]\\b"
    ],
    "min_score": 25
  },
  "salary_slip": {
    "keywords": [
      "payslip",
      "salary slip",
      "earnings",
      "deductions",
      "basic salary",
      "house rent allowance",
      "hra",
      "gross earnings",
      "net pay",
      "provident fund",
      "epf"
    ],
    "regex": [
      "net\\s+pay",
      "gross\\s+earnings"
    ],
    "min_score": 25
  },
  "bank_statement": {
    "keywords": [
      "statement of account",
      "account holder",
      "account number",
      "opening balance",
      "closing balance",
      "ifsc",
      "transaction",
      "debit",
      "credit",
      "balance"
    ],
    "regex": [
      "\\b[A-Z]{4}0[A-Z0-9]{6}\\b",
      "statement\\s+of\\s+account"
    ],
    "min_score": 25
  },
  "loan_application": {
    "keywords": [
      "loan application",
      "applicant name",
      "declared monthly income",
      "loan amount",
      "purpose of loan",
      "co-applicant",
      "repayment tenure"
    ],
    "regex": [
      "loan\\s+amount[:\\s]+[\\d,]+",
      "declared\\s+(?:monthly|annual)\\s+income"
    ],
    "min_score": 25
  },
  "declaration_15g": {
    "keywords": [
      "form 15g",
      "15g",
      "declaration under section 197a",
      "estimated annual income",
      "financial year",
      "tax deduction",
      "previous year income"
    ],
    "regex": [
      "form\\s+15\\s*[Gg]",
      "\\b197[Aa]\\b"
    ],
    "min_score": 25
  },
  "payment_instruction": {
    "keywords": [
      "payment instruction",
      "neft",
      "rtgs",
      "fund transfer",
      "beneficiary name",
      "beneficiary account",
      "ifsc code",
      "instruction date",
      "remitter"
    ],
    "regex": [
      "neft|rtgs|imps",
      "beneficiary\\s+account\\s+number"
    ],
    "min_score": 25
  }
}
